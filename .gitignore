# ─────────────────────────────────────────────────────────────────────────────
# .gitignore – HealthAI Platform monorepo
# Python microservices · Next.js frontend · Docker · Kubernetes
# ─────────────────────────────────────────────────────────────────────────────

# ── Nested git repositories (remove before committing) ───────────────────────
HealthAI-Platform/

# ── Secrets & environment ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
secrets/
credentials/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg
MANIFEST
.installed.cfg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.eggs/
pip-wheel-metadata/

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# Linters & formatters
.ruff_cache/

# Testing & coverage
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
coverage/
*.cover
*.coveralls.json
nosetests.xml
test-results/
junit.xml

# Jupyter / IPython
.ipynb_checkpoints/
*.ipynb

# Alembic
# (keep alembic.ini and migrations/ tracked — only exclude local overrides)
alembic.ini.local

