FROM python:3.12-slim AS base
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

COPY shared/ /app/shared/

# Install sentence-transformers instead of openai for embeddings
COPY services/rag-service/requirements.free.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY services/rag-service/ /app/

# Use free version of main.py
CMD ["uvicorn", "main_free:app", "--host", "0.0.0.0", "--port", "8002"]

ENV PYTHONPATH=/app:/app/shared
EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8002/health || exit 1
