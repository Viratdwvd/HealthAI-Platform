# ──────────────────────────────────────────────────────────────────────────────
# .env.example – FREE LOCAL VERSION
# No paid API keys needed! Copy to .env and only set SECRET_KEY
# ──────────────────────────────────────────────────────────────────────────────

# ── Only required setting ─────────────────────────────────────────────────────
SECRET_KEY=any-random-string-at-least-32-characters-long

# ── Everything below has working defaults ─────────────────────────────────────

# AI runs locally via Ollama (no API keys needed)
OLLAMA_PRIMARY_MODEL=llama3.2
OLLAMA_FALLBACK_MODEL=mistral

# Local infrastructure (works with docker compose out of the box)
KAFKA_BOOTSTRAP=kafka:9092
REDIS_URL=redis://redis:6379/0
VECTOR_DB_URL=http://qdrant:6333
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@postgres:5432/healthcare
OTLP_ENDPOINT=http://jaeger:4317

LOG_LEVEL=INFO
ENVIRONMENT=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Optional: use a free cloud LLM instead of local Ollama ───────────────────
# Groq (free tier, very fast): https://console.groq.com
# GROQ_API_KEY=gsk_...
#
# Google Gemini (free tier): https://aistudio.google.com
# GEMINI_API_KEY=AIza...
#
# HuggingFace (free tier): https://huggingface.co/settings/tokens
# HF_API_KEY=hf_...
